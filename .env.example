HIPS_DB_HOST=localhost
HIPS_DB_PORT=5432
HIPS_DB_NAME=hips_db
HIPS_DB_USER=hips_app
HIPS_DB_PASSWORD=change_me

HIPS_LOG_DIR=/var/log/hips
HIPS_ALERT_EMAIL=admin@example.com
HIPS_FAILED_LOGIN_THRESHOLD=5
HIPS_FAILED_LOGIN_WINDOW_MINUTES=10

# Email alerts
HIPS_EMAIL_DRY_RUN=true
HIPS_ALERT_EMAIL=admin@example.com
HIPS_SMTP_HOST=localhost
HIPS_SMTP_PORT=25
HIPS_SMTP_USER=
HIPS_SMTP_PASSWORD=
HIPS_SMTP_FROM=hips@localhost
